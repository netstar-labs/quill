#!/usr/bin/env bash
# The release build (decisions 54, 70): refuses a dirty or untagged tree, cross-compiles the
# quill command with the version stamped in, and writes release archives, checksums and an
# SBOM into build/install/ (wiped each run, not tracked).
#
#   build/quill            a release build of the tag the tree sits on
#   build/quill --dev      a development build of the working tree (version "dev-<sha>"), no refusal
set -euo pipefail
cd "$(dirname "$0")/.."
export GOWORK=off CGO_ENABLED=0
# Under GOTOOLCHAIN=auto go.mod's toolchain line is only a minimum, and the binaries and the SBOM
# depend on the compiler. Pin it exactly, as hack/gate.sh does (keep the two in step).
toolchain=$(sed -n 's/^toolchain //p' go.mod)
[ -n "$toolchain" ] || toolchain="go$(sed -n 's/^go //p' go.mod)"
case "$toolchain" in go[0-9]*.[0-9]*.[0-9]*) ;; go[0-9]*.[0-9]*) toolchain="$toolchain.0" ;; esac
export GOTOOLCHAIN="$toolchain"
# The compiler's architecture level is part of the binary: a builder's GOAMD64=v3 or
# GOARM64=v9.0 (in the shell or in `go env -w`'s file, which the environment overrides) would
# ship AVX2 or v9 instructions that an older CPU dies on with SIGILL, and a verifier on the
# defaults could not reproduce the hash. Pin the baselines, the toolchain's own defaults.
export GOAMD64=v1 GOARM64=v8.0
# Nothing in the output depends on the clock or the builder: the SBOM time stamp and every
# archive entry's mtime are the commit time, entries are sorted, owners are root with no names,
# and the gzip header carries no time. So a rebuild of one commit with the same tar, gzip and Go
# writes the same files. It is not the same across tar and gzip implementations (GNU and bsdtar
# format header fields and deflate differently), so a verifier on another system compares the
# extracted files, the binaries above all. `go build` also stamps vcs.revision and vcs.time into
# a build made inside a git checkout and not into one made from a source archive; pass
# GOFLAGS=-buildvcs=false on both sides to compare binaries across the two.
umask 022
export TZ=UTC

dev=0
[ "${1:-}" = "--dev" ] && dev=1

if [ "$dev" = 0 ]; then
	if [ -n "$(git status --porcelain)" ]; then
		echo "build/quill: the tree is dirty; commit or stash, or use --dev" >&2
		exit 1
	fi
	version=$(git describe --tags --exact-match 2>/dev/null) || {
		echo "build/quill: HEAD is not tagged; tag it (v0.y.z) or use --dev" >&2
		exit 1
	}
else
	# errexit-safe: a `[ ... ] && echo` inside the substitution ends the script on a clean tree
	dirty=""
	[ -z "$(git status --porcelain)" ] || dirty=-dirty
	version="dev-$(git rev-parse --short HEAD)$dirty"
fi

out=build/install
rm -rf "$out"
mkdir -p "$out"
module=$(sed -n 's/^module //p' go.mod)
gover=$(go version | awk '{print $3}')
built=$(git show -s --format=%cd --date=format-local:%Y-%m-%dT%H:%M:%SZ HEAD)
stamp=$(git show -s --format=%cd --date=format-local:%Y%m%d%H%M.%S HEAD)
commit=$(git rev-parse HEAD)

# GNU tar and bsdtar spell "owner 0, no names" differently. A command substitution, not a pipe
# into grep -q: under pipefail a SIGPIPE from tar could otherwise pick the wrong spelling.
case "$(tar --version 2>&1)" in
*"GNU tar"*) owner=(--owner=0 --group=0 --numeric-owner) ;;
*) owner=(--uid 0 --gid 0 --uname '' --gname '') ;;   # bsdtar
esac

for target in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64; do
	os=${target%/*}; arch=${target#*/}
	name="quill_${version}_${os}_${arch}"
	dir="$out/$name"
	mkdir -p "$dir"
	echo "==> $target"
	GOOS=$os GOARCH=$arch go build -trimpath -ldflags "-s -w -X main.version=$version" -o "$dir/quill" ./cmd/quill
	cp README.md CHANGELOG.md SECURITY.md "$dir/"
	[ -f LICENSE ] && cp LICENSE "$dir/"
	find "$dir" -exec touch -t "$stamp" {} +
	(cd "$out" && find "$name" | LC_ALL=C sort |
		tar --no-recursion --format=ustar "${owner[@]}" -cf - -T - | gzip -n > "$name.tar.gz")
	rm -r "$dir"
done

# The SBOM: CycloneDX 1.5 JSON. The module has no dependencies; the Go toolchain is the
# only other component that reaches the binary. The dependency edge names both by bom-ref.
cat > "$out/quill_${version}.cdx.json" <<JSON
{
  "bomFormat": "CycloneDX",
  "specVersion": "1.5",
  "version": 1,
  "metadata": {
    "timestamp": "$built",
    "component": {
      "type": "application",
      "bom-ref": "pkg:golang/$module@$version",
      "name": "quill",
      "version": "$version",
      "purl": "pkg:golang/$module@$version",
      "properties": [
        {"name": "vcs.commit", "value": "$commit"},
        {"name": "go.version", "value": "$gover"}
      ]
    }
  },
  "components": [
    {
      "type": "library",
      "bom-ref": "pkg:golang/stdlib@${gover#go}",
      "name": "go (standard library)",
      "version": "$gover",
      "purl": "pkg:golang/stdlib@${gover#go}"
    }
  ],
  "dependencies": [
    {"ref": "pkg:golang/$module@$version", "dependsOn": ["pkg:golang/stdlib@${gover#go}"]}
  ]
}
JSON

(cd "$out" && shasum -a 256 -- *.tar.gz *.cdx.json > SHA256SUMS)
printf '%s %s %s\n' "$version" "$commit" "$built" >> build/quill.version 2>/dev/null || true
echo "==> $out"
ls -1 "$out"
